# Copy to .env and fill before production deploy
#   cp .env.example .env

# REQUIRED in production (DEBUG=false)
SECRET_KEY=replace-with-long-random-string

# true for local only
DEBUG=false

# Comma-separated hostnames (no scheme).
# On Render, RENDER_EXTERNAL_HOSTNAME is also auto-added by settings.py,
# but set ALLOWED_HOSTS explicitly for clarity / non-Render hosts.
ALLOWED_HOSTS=firmwarebackend.onrender.com,localhost,127.0.0.1,backend

# Public dashboard origin (no trailing slash)
FRONTEND_URL=https://apex-sensor-lab.onrender.com

# Must include the browser origin of the frontend
CORS_ALLOWED_ORIGINS=https://apex-sensor-lab.onrender.com
CSRF_TRUSTED_ORIGINS=https://apex-sensor-lab.onrender.com

# Optional tuning
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
API_PORT=8000
WEB_PORT=8080
